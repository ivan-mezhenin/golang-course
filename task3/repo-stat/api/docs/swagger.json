{
    "schemes": [
        "http"
    ],
    "swagger": "2.0",
    "info": {
        "description": "API Gateway для получения информации о GitHub репозиториях",
        "title": "Repo Stat Gateway",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/",
    "paths": {
        "/api/ping": {
            "get": {
                "description": "Отправляет ping-запросы в Processor и Subscriber и возвращает статус каждого сервиса",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Ping"
                ],
                "summary": "Проверка здоровья сервисов",
                "responses": {
                    "200": {
                        "description": "Все сервисы работают",
                        "schema": {
                            "$ref": "#/definitions/repo-stat_api_internal_dto.PingResponse"
                        }
                    },
                    "503": {
                        "description": "Один или несколько сервисов недоступны",
                        "schema": {
                            "$ref": "#/definitions/repo-stat_api_internal_dto.PingResponse"
                        }
                    }
                }
            }
        },
        "/api/repositories/info": {
            "get": {
                "description": "Принимает URL GitHub репозитория и возвращает его основные данные",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "repositories"
                ],
                "summary": "Получить информацию о репозитории по URL",
                "parameters": [
                    {
                        "type": "string",
                        "description": "URL репозитория (например: https://github.com/octocat/Hello-World)",
                        "name": "url",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/repo-stat_api_internal_dto.RepoResponse"
                        }
                    },
                    "400": {
                        "description": "Некорректный URL или параметры",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "404": {
                        "description": "Репозиторий не найден",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "429": {
                        "description": "Превышен лимит запросов GitHub",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "500": {
                        "description": "Внутренняя ошибка сервера",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "repo-stat_api_internal_dto.PingResponse": {
            "type": "object",
            "properties": {
                "services": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/repo-stat_api_internal_dto.ServiceStatus"
                    }
                },
                "status": {
                    "type": "string"
                }
            }
        },
        "repo-stat_api_internal_dto.RepoResponse": {
            "type": "object",
            "properties": {
                "created_at": {
                    "type": "string"
                },
                "description": {
                    "type": "string"
                },
                "forks": {
                    "type": "integer"
                },
                "full_name": {
                    "type": "string"
                },
                "stars": {
                    "type": "integer"
                },
                "visibility": {
                    "type": "string"
                }
            }
        },
        "repo-stat_api_internal_dto.ServiceStatus": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string"
                },
                "status": {
                    "type": "string"
                }
            }
        }
    }
}